# Copy this file to .env and fill in your values.
# When using the dev container, the NEO4J_* vars below are pre-set
# to the local containerised Neo4j instance.

# --- Neo4j ---
NEO4J_URI=neo4j://neo4j:7687        # use bolt://localhost:7687 outside the container
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword

# --- App ---
PORT=8000
LOG_LEVEL=INFO
# VPIS_LOG_LEVEL=DEBUG

# --- Auth middleware ---
MCP_ISSUER=https://mcp.fh-swf.cloud

# --- AWS / S3 (if needed) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
